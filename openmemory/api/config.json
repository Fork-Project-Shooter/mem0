{
  "openmemory": {
    "custom_instructions": null
  },
  "mem0": {
    "llm": {
      "provider": "deepseek",
      "config": {
        "model": "deepseek-chat",
        "temperature": 0.1,
        "max_tokens": 2000,
        "api_key": "env:LLM_API_KEY"
      }
    },
    "embedder": {
      "provider": "fastembed",
      "config": {
        "model": "BAAI/bge-small-zh-v1.5"
      }
    },
    "vector_store": {
      "provider": "qdrant",
      "config": {
        "collection_name": "openmemory",
        "host": "mem0_store",
        "port": 6333,
        "embedding_model_dims": 512
      }
    }
  }
}
